direction: down

hub: {
  label: "ACM Hub Validation (local-cluster)"
  style.fill: "#F7F8FB"
  grid-columns: 4
  platform: "Platform\nClusterVersion · COs · MCPs\nnodes · CSRs · etcd · API p99"
  acm: "ACM Hub\nMCH phase + components\nMCE · CSV · pods"
  backup: "Backup & DR\ncluster-backup · OADP · BSL\nschedule · last backup · policy"
  obs: "Observability\nMCO Ready · pods · UWM"
  gov: "Governance\nOperatorPolicies ≥ N\nConfigurationPolicies ≥ N\nall Compliant · root placement"
  gitops: "GitOps\nArgo CD · apps Synced\napps Healthy · GitOpsCluster"
  fleet: "Fleet\nclusters Available / joined\nlocal add-ons · fleet compliance"
}

managed: {
  label: "Managed Cluster Validation (per cluster)"
  style.fill: "#F7F8FB"
  grid-columns: 4
  reg: "Registration\naccepted · joined · available\nimport · clock · lease"
  agents: "Agents & Add-ons\nrequired add-ons · Available\nklusterlet (probe)"
